{
  "name": "@video-ad-network/ui",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "deploy": "NODE_ENV=production wrangler deploy",
    "dev": "react-router dev",
    "start": "wrangler dev",
    "lint": "biome lint .",
    "format": "prettier --check . --experimental-cli",
    "format:fix": "prettier --write . --experimental-cli",
    "typecheck": "react-router typegen && tsc",
    "typegen": "wrangler types --strict-vars=false",
    "validate": "run-p format lint && run-p typecheck",
    "auth:create-admin": "tsx scripts/create-admin.ts",
    "auth:create-admin:production": "tsx scripts/create-admin.ts --production"
  },
